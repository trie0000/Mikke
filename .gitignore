node_modules/
# Build artifacts: keep the standalone HTML + bundle under version control;
# ignore the regenerable JS sourcemap.
dist/*
!dist/index.html
!dist/install.html
!dist/install-loader.html
!dist/bookmarklet.txt
!dist/mikke.bundle.js
!dist/version.txt
# relay self-update 用の配置物 (= build.js が scripts/ からコピー + 自動生成)。
!dist/mikke-relay.ps1
!dist/mikke-launch.ps1
!dist/mikke-relay.bat
!dist/mikke-launch.bat
!dist/relay-version.txt
!dist/mikke-relay.env.example
!dist/mikke-scanner-adapter.example.ps1
!dist/SCANNER-ADAPTER-SPEC.md
!dist/SETUP-README.md
!dist/README.md
*.log
.DS_Store
.vscode/

# relay 自己更新 (updater.bat) が生成するバックアップ / ステージング ファイル。
*.bak
*.new
*.orig
*~

# relay の個人設定 (テンプレートは .example として残す)
scripts/mikke-relay.env
# 検査ツール API アダプタの実装版 (委託先環境で作成。API 仕様・URL を公開リポに置かない)
scripts/mikke-scanner-adapter.ps1
dist/mikke-scanner-adapter.ps1
.claude/

# 開発専用の指示書。pull 同期対象外 (リポジトリで配布しない / 各自ローカル管理)。
CLAUDE.md
