# mikke-relay.env.example — コピーして mikke-relay.env として使う
# 書式: KEY=VALUE (# はコメント、空行無視)。
# 優先順位: 引数 > OS 環境変数 > .env。
# ⚠ 同名の OS 環境変数が残っていると .env は無視される。接続先が反映され
#    ない時はまず OS 環境変数を疑うこと。

# Mikke を開く SharePoint サイト URL (mikke-launch が開く)
MIKKE_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>

# 中継サーバの待受ポート (既定 18120 = Mikke の割当。共通ガイド §14.2)。
# ★ ここだけ直せばよい。UI 側に設定する場所は無い。
#   - ランチャー起動 … 起動時にブラウザへ接続先を書き込む
#   - ブックマークレット起動 … 既定ポートから連番で自動的に探す (18120〜18139)
# MIKKE_RELAY_PORT=18120

# バンドル (mikke.bundle.js) の読込元。既定 local。
#   local … relay の配信フォルダから読む (開発中。ビルドし直すだけで反映される)
#   sp    … SharePoint の ドキュメント/Mikke から読む (本番と同じ経路)
# ★ ここだけ直せばよい。UI 側に設定欄は無い (表示のみ)。
# MIKKE_BUNDLE_SOURCE=local

# local のときの読込元 base。既定は relay と同じポート (MIKKE_RELAY_PORT に追従)。
# 別のホスト/ポートに置いている場合だけ指定する。
# MIKKE_BUNDLE_LOCAL_BASE=http://127.0.0.1:18120/mikke

# relay が mikke.bundle.js / version.txt を読むフォルダ (既定 = relay と同じフォルダ)。
# 開発中はビルド先 dist を指定すると、ビルドし直すだけで反映される。
# MIKKE_BUNDLE_DIR=C:\Users\...\Mikke\dist

# 脆弱性検査ツール API
# ★ 通常はここに書かない。Mikke の 設定 → 個人設定 → 接続 → 検査ツール API で
#   各自のブラウザに設定し、実行のたびに中継サーバへ引数で渡す
#   (秘密情報を配布物・バックアップ・リポジトリに残さないため)。
# 下の 2 つは、引数が来なかったときのフォールバックとしてだけ効く。
# MIKKE_SCANNER_API_BASE=https://<scanner-api-host>
# MIKKE_SCANNER_API_KEY=<api-key>

# ─── CDP ワンクリック起動 (mikke-launch) ───────────────────────────────
# 専用プロファイルの Edge を起動し、サインインを検知したら Mikke を自動注入する。
# 失敗時は従来どおり「既定ブラウザ + ブックマークレット」にフォールバックする。
# MIKKE_CDP=0                     # CDP を無効化して従来フロー固定
# MIKKE_CDP_PORT=19320            # CDP のデバッグポート (既定 19320 = Mikke の割当)
#                                 # 他の CDP ツールと重なると相手のブラウザに注入して
#                                 # しまうため、重複しない値にすること
# MIKKE_EDGE_PATH=                # msedge.exe のパス (未設定なら自動探索)
# MIKKE_EDGE_USERDATA=            # 専用プロファイルの場所 (既定 %LOCALAPPDATA%\mikke-edge)
